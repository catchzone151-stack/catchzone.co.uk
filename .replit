modules = ["nodejs-20"]

run = "npm run dev"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[agent]
expertMode = true

[userenv]

[userenv.production]
VOICE_DEMO_SPEND_CONTROLS_CONFIRMED = "true"
